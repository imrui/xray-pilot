server:
  port: 2026
  mode: release  # debug | release

database:
  driver: sqlite  # sqlite | postgres
  dsn: xray-pilot.db
  # PostgreSQL 示例:
  # driver: postgres
  # dsn: "host=localhost user=postgres password=changeme dbname=xray_pilot port=5432 sslmode=disable"

jwt:
  secret: "change-me-use-a-long-random-string"  # 生产环境必须修改
  expire: 24  # JWT 有效期（小时）

crypto:
  # AES-GCM 主密钥，用于加密节点 PrivateKey。
  # 留空则首次启动时自动生成并打印到日志，建议将其复制回此处后重启。
  # 也可通过环境变量覆盖：XRAY_PILOT_MASTER_KEY=<hex-key>
  master_key: ""

ssh:
  default_port: 22
  default_user: "root"
  default_key_path: ""  # 例如: /etc/xray-pilot/ssh/id_ed25519
  known_hosts_path: "/var/lib/xray-pilot/known_hosts"

# 管理员种子：仅首次启动（admin_users 表为空）时写入数据库，第一个为超级管理员。
# 之后管理员在面板「系统设置 → 管理员账号」维护，本段被忽略。
admins:
  - username: admin
    password: "change-me-now"
